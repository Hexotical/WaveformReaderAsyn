#}

record(waveform, "$(USER):WAVEFORM:0")
{
    field(PINI, "1")
    field(DTYP, "asynInt16ArrayIn")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))WAVEFORM:0")
    field(FTVL, "SHORT")
    field(NELM, "$(WAVEFORM_SIZE)")
    field(FLNK, "$(USER):X_WAVEFORM:0 PP")
    field(SCAN, "I/O Intr")
  }

# Create a waveform with the sampling time. This will be the X axis of the
# waveform.
record (aSub, "$(USER):X_WAVEFORM:0") {
  field(SNAM, "calcTimeArray")
  field(FTA, "LONG")
  field(FTVA, "DOUBLE")
  field(NOVA, "$(WAVEFORM_SIZE)")
  field(INPA, "$(USER):CLK:FREQUENCY CP")
  field(OUTA, "$(USER):X_WF:0")
  field(FLNK, "$(USER):X_WF:0 PP")
}

# Interface PV, to display only the necessary data
# range from the data received in the buffer
record(subArray, "$(USER):X_WF:0") 
{
  field(DESC,    "X Subarray")
  field(INP,     "$(USER):X_WAVEFORM:0.VALA")
  field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))WAVEFORM_X_AXIS:0")
  field(FTVL,    "DOUBLE")
  field(MALM,    "$(WAVEFORM_SIZE)")
  field(NELM,    "1024")
  field(INDX,    "0")
  field(FLNK,    "$(USER):WAVEFORM:RAW:0 PP")
  field(EGU,     "ns")
}

# Interface PV, to display only the necessary data
# range from the data received in the buffer
record(subArray, "$(USER):WAVEFORM:RAW:0") 
{
  field(DESC,    "Raw Subarray")
  field(INP,     "$(USER):WAVEFORM:0")
  field(FTVL,    "SHORT")
  field(MALM,    "$(WAVEFORM_SIZE)")
  field(NELM,    "1024")
  field(INDX,    "0")
  #field(FLNK,   "$(USER):WAVEFORM:R2E:0 PP")
}

# PV to calculate the interface pv in user units
record (aSub, "$(USER):WAVEFORM:R2E:0") 
{
  field(DESC, "subarray raw to egu")
  field(SNAM, "calcWaveformInEGU")
  field(INPA, "$(USER):WF:RAW PP")
  field(NOA, "$(WAVEFORM_SIZE)")
  field(FTA, "SHORT")
  field(INPB, "$(USER):SLOPE:WF:0 PP")
  field(FTB, "DOUBLE")
  field(INPC, "$(USER):OFFSET:WF:0 PP")
  field(FTC, "SHORT")
  field(OUTA, "$(USER):WF:0")
  field(FLNK, "$(USER):WF:0")
  field(NOVA, "$(WAVEFORM_SIZE)")
  field(FTVA, "DOUBLE")
}

record(calcout, "$(USER):SLOPE:WF:CALC:0") 
{
  field(DESC,    "WF slope")
  field(PREC,    "3")
  field(FLNK,    "$(USER):SLOPE:WF:0")
  field(CALC,    "A*.5")
  field(INPA,    "$(USER):SLOPE:0 CPP")
}

# PV to hold the slope for the display array (raw to egu conversion)
record(ao, "$(USER):SLOPE:WF:0") 
{
  field(DESC,    "WF slope")
  field(PREC,    "3")
  field(PINI,    "YES")
  field(FLNK,    "$(USER):WAVEFORM:R2E:0")
  field(OMSL,    "closed_loop")
  field(DOL,     "$(USER):SLOPE:WF:CALC:0")
}

# PV to hold the offset for the display array (raw to egu conversion)
record(ao, "$(USER):OFFSET:WF:0") 
{
  field(DESC,    "WF offset in raw")
  field(PINI,    "YES")
  field(FLNK,    "$(USER):WAVEFORM:R2E:0")
  field(EGU,     "raw")
  field(OMSL,    "closed_loop")
  field(DOL,     "$(USER):OFFSET:CALC:0")
}

# Interface PV, to display only the necessary data
# range from the data received in the buffer in user units
record(subArray, "$(USER):WF:0") 
{
  field(DESC,    "Subarray")
  field(INP,     "$(USER):WAVEFORM:R2E:0.VALA")
  field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))REFINED_WAVEFORM:0")
  field(FTVL,    "DOUBLE")
  field(MALM,    "$(WAVEFORM_SIZE)")
  field(NELM,    "1024")
  field(INDX,    "0")
}

record(ao, "$(USER):WF:START:EGU:0")
{
  field(DESC,    "Subarray start EGU")
  field(DRVH,    "2857143")
  field(HOPR,    "2857143")
  field(FLNK,    "$(USER):WF:START:CALC:0")
  info(autosaveFields, "VAL")
  field(PINI,    "YES")
  field(EGU,     "ns")
}

# PV to hold the start for the display array
record(calcout, "$(USER):WF:START:CALC:0")
{
  field(DESC,    "Subarray start EGU")
  field(FLNK,    "$(USER):WF:START:0")
  field(OUT,     "$(USER):WF:START:0")
  field(INPA,    "$(USER):WF:START:EGU:0")
  field(INPB,    "$(USER):CLK:FREQUENCY CP")
  field(CALC,    "FLOOR((2*A*B)/1000)")
}

record(ao, "$(USER):WF:START:0") 
{
  field(DESC,    "Subarray start")
  field(DRVH,    "$(WAVEFORM_SIZE)")
  field(HOPR,    "$(WAVEFORM_SIZE)")
  field(PINI,    "NO")
  field(FLNK,    "$(USER):WF:SEQ:0")
  field(DOL,     "$(USER):WF:START:CALC:0")
  field(OMSL,    "closed_loop")
}

record(ao, "$(USER):WF:NELM:EGU:0")
{
  field(DESC,    "Subarray start EGU")
  field(DRVH,    "2857143")
  field(HOPR,    "2857143")
  field(FLNK,    "$(USER):WF:NELM:CALC:0")
  info(autosaveFields, "VAL")
  field(PINI,    "YES")
  field(EGU,     "ns")
}

# PV to hold the start for the display array
record(calcout, "$(USER):WF:NELM:CALC:0")
{
  field(DESC,    "Subarray start EGU")
  field(FLNK,    "$(USER):WF:NELM:0")
  field(OUT,     "$(USER):WF:NELM:0")
  field(INPA,    "$(USER):WF:NELM:EGU:0")
  field(INPB,    "$(USER):CLK:FREQUENCY CP")
  field(CALC,    "FLOOR((2*A*B)/1000)")
}

# PV to hold the length for the display array
record(ao, "$(USER):WF:NELM:0") 
{
  field(DESC,    "Subarray length")
  field(PINI,    "NO")
  field(FLNK,    "$(USER):WF:SEQ:0")
  field(DOL,     "$(USER):WF:NELM:CALC:0")
  field(OMSL,    "closed_loop")
}

# PV to send data start and nelm to raw and wf PVs
record(seq, "$(USER):WF:SEQ:0") 
{
  field(DESC, "Update NELM and INDX value")
  field(DOL1, "$(USER):WF:START:0")
  field(LNK1, "$(USER):WF:RAW:0.INDX PP")

  field(DOL2, "$(USER):WF:NELM:0")
  field(LNK2, "$(USER):WF:RAW.NELM:0 PP")

  field(DOL3, "$(USER):WF:NELM:0")
  field(LNK3, "$(USER):WF.NELM:0 PP")

  field(DOL4, "$(USER):WF:START:0")
  field(LNK4, "$(USER):X:WF:0.INDX PP")

  field(DOL5, "$(USER):WF:NELM:0")
  field(LNK5, "$(USER):X:WF:0.NELM PP")

  field(ASG,  "Internal")
}


record(subArray, "$(USER):SUBARRAY:0")
{
  field(INP, "$(USER):WAVEFORM:0.VAL")
  field(FTVL, "SHORT")
  field(MALM, "$(WAVEFORM_SIZE)")
  field(NELM, "25000")
  field(INDX, "0")
  field(SCAN, "Passive")
  }


record(longin, "$(USER):BEGIN:ADDR:0")
{
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT), $(ADDR), $(TIMEOUT))BEGIN_ADDR0")
    field(SCAN, "I/O Intr")
  }


record(longin, "$(USER):END:ADDR:0")
{
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT), $(ADDR), $(TIMEOUT))END_ADDR0")
    field(SCAN, "I/O Intr")
  }


record(ao, "$(USER):WORD:COUNT:0")
{
    field(SCAN, "Passive")
    field(OUT, "$(USER):INIT:SEQ:0  PP")
  }


record(seq, "$(USER):INIT:SEQ:0")
{
    field(SCAN, "Passive")
    field(DOL1, "$(USER):WORD:COUNT:0")
    field(LNK1, "$(USER):FANOUT:BUFFER:0 PP")
    field(DO2, "1")
    field(LNK2, "$(USER):WEB:INIT:0 PP")
  }


record(dfanout, "$(USER):FANOUT:BUFFER:0")
{
    field(SCAN, "Passive")
    field(OUTA, "$(USER):BUFFER:RBV:0 PP")
    field(OUTB, "$(USER):TO:DIV:0.A PP")
    field(OUTC, "$(USER):WEB:INIT:0.A PP")
  }


record(ai, "$(USER):BUFFER:RBV:0")
{
    field(SCAN, "Passive")
  }


record(calcout, "$(USER):TO:DIV:0")
{
    field(SCAN, "Passive")
    field(CALC, "A/2")
    field(OUT, "$(USER):BUFFER:SIZE PP")
  }


record(ao, "$(USER):STARTING:LOC:0")
{
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))START_LOC0")
    field(SCAN, "Passive")
}


record(ao, "$(USER):ENDING:LOC:0")
{
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))END_LOC0")
    field(SCAN, "Passive")
}


record(ai, "$(USER):BEAM:LOSS:LOC:0")
{
    field(DTYP, "asynFloat64")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))BEAM_LOSS_LOC0")
    field(SCAN, "I/O Intr")
}

## This represents the threshold for finding the peak value of beam ##
## loss; if the value is lower than this, then it should considered noise ##
record(ao, "$(USER):THRESHOLD:0") 
{
  field(DTYP, "asynInt32")
  field(SCAN, "Passive")
  field(DESC, "Threshold for beam loss")
  field(VAL, 0)
  field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))THRESHOLD:0")
}

# Length of the fiber
# Assuming units of meters 
record(ao,      "$(USER):LENGTH:0") {
    field(DESC, "Length in m")
    field(PINI, "YES")
    field(SCAN, "Passive")
    field(PREC, "3")
    field(VAL,  "100")
    info(autosaveFields, "VAL")
}

