##Template file waveform

record(ao,      "$(USER):SLOPE:0") {
    field(DESC, "Slope of channel in EGU/raw")
    field(PINI, "YES")
    field(SCAN, "Passive")
    field(PREC, "3")
    field(VAL,  "1")
    info(autosaveFields, "VAL")
}
record(ao,      "$(USER):OFFSET:0") {
    field(DESC, "Offset of channel in EGU")
    field(PINI, "YES")
    field(SCAN, "Passive")
    field(PREC, "3")
    field(VAL,  "1")
    info(autosaveFields, "VAL")
}

