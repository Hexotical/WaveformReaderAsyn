{
    field(DESC, "Location of the start of the fiber in m")
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))Z_OFFSET_START1")
    field(SCAN, "Passive")
    field(VAL,  "0")
}

# Physical location of the end of the fiber
# Assuming units of meters
record(ao,      "$(P):Z:OFFSET:END:1") {
    field(DESC, "Location of the end of the fiber in m")
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))Z_OFFSET_END1")
    field(SCAN, "Passive")
    field(VAL,  "100")
}

# Physical location of the start of the extraction range
# Assuming units of meters
record(ao,      "$(P):START:EXTRACTION:1") {
    field(DESC, "Start of extraction range in m")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))EXTRACTION_START1")
    field(SCAN, "Passive")
    field(VAL,  "0")
}

# Physical location of the end of the extraction range
# Assuming units of meters
record(ao,      "$(P):END:EXTRACTION:1") {
    field(DESC, "End of extraction range in m")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))EXTRACTION_END1")
    field(SCAN, "Passive")
    field(VAL,  "100")
}

record(ai, "$(P):EXTRACTED:NO:OF:ELEMENTS:1")
{
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))EXTRACTED_NO_OF_ELEMENTS1")
    #field(FLNK,    "$(P):WAVEFORM:RAW:1 PP")
    field(SCAN, "I/O Intr")
    field(VAL, "100")
}

