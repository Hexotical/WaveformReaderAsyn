  field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))WAVEFORM_X_AXIS:1")
  field(FTVL,    "DOUBLE")
  field(MALM,    "$(WAVEFORM_SIZE)")
  field(NELM,    "1024")
