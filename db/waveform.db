record(waveform, "$(P):WAVEFORM:2")
{
    field(PINI, "1")
    field(DTYP, "asynInt16ArrayIn")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))WAVEFORM:2")
    field(FTVL, "SHORT")
    field(NELM, "$(WAVEFORM_SIZE)")
    #field(FLNK, "$(P):X_WAVEFORM:2 PP")
    field(FLNK, "$(P):SUBARRAY:2 PP")
    field(SCAN, "I/O Intr")
  }

