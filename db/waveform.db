record(waveform, "$(P):EXTRACTED:WF:1") 
{
  field(PINI, "1")
  field(DESC,    "X Subarray")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))EXTRACTED_WAVEFORM:1")
  field(DTYP, "asynInt16ArrayIn")
  field(FTVL,    "USHORT")
  # NELM is the maximum number of values, NORD is the number of values actually read
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}##Template file waveform

record(ao,      "$(P):SLOPE:2") {
    field(DESC, "Slope of channel in EGU/raw")
    field(PINI, "YES")
    field(SCAN, "Passive")
    field(PREC, "3")
    field(VAL,  "1")
    info(autosaveFields, "VAL")
}
record(ao,      "$(P):OFFSET:2") {
    field(DESC, "Offset of channel in EGU")
    field(PINI, "YES")
    field(SCAN, "Passive")
    field(PREC, "3")
    field(VAL,  "1")
    info(autosaveFields, "VAL")
}

