# Assuming units of meters
record(ao,      "$(P):START_EXTRACTION_2") {
    field(PINI, "YES")
    field(DESC, "Start of extraction range in m")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))EXTRACTION_START2")
    field(SCAN, "Passive")
    field(VAL,  "20")
    field(PREC, "3")
    field(EGU, "m")
}

# Physical location of the end of the extraction range
# Assuming units of meters
record(ao,      "$(P):END_EXTRACTION_2") {
    field(PINI, "YES")
    field(DESC, "End of extraction range in m")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))EXTRACTION_END2")
    field(SCAN, "Passive")
    field(VAL,  "80")
    field(PREC, "3")
    field(EGU, "m")
}

# The number of samples in the extracted range of values
record(ai, "$(P):EXTRACTED_NO_OF_ELEMENTS_2")
{
    field(DTYP, "asynInt32")
    #field(PINI, "YES")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))EXTRACTED_NO_OF_ELEMENTS2")
    field(SCAN, "I/O Intr")
    #field(VAL, "100")
}

# The X-axis of the waveform before extraction, contains distance values in m
record(waveform, "$(P):COMPLETE_X_WF_2") 
{
  field(PINI, "1")
  field(DESC,    "X Subarray")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))COMPLETE_X_AXIS:2")
  field(DTYP, "asynFloat64ArrayIn")
  field(FTVL,    "DOUBLE")
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}

# Values of the waveform before extraction
record(waveform, "$(P):COMPLETE_WF_2") 
{
  field(PINI, "1")
  field(DESC,    "Subarray")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))COMPLETE_WAVEFORM:2")
  field(DTYP, "asynInt16ArrayIn")
  field(FTVL,    "SHORT")
  # NELM is the maximum number of values, NORD is the number of values actually read
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}

# The X-axis of the final extracted waveform, contains distance values in m
record(waveform, "$(P):EXTRACTED_X_WF_2") 
{
  field(PINI, "1")
  field(DESC,    "X Subarray")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))EXTRACTED_X_AXIS:2")
  field(DTYP, "asynFloat64ArrayIn")
  field(FTVL,    "DOUBLE")
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}

# Values of the extracted waveform
record(waveform, "$(P):EXTRACTED_WF_2") 
{
  field(PINI, "1")
  field(DESC,    "Extracted Subarray")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))EXTRACTED_WAVEFORM:2")
  field(DTYP, "asynInt16ArrayIn")
  field(FTVL,    "SHORT")
  # NELM is the maximum number of values, NORD is the number of values actually read
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}


record(ai, "$(P):INTERVAL_2")
{
    field(DTYP, "asynInt32")
    #field(PINI, "YES")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))INTERVAL2")
    field(SCAN, "I/O Intr")
    #field(VAL, "100")
}