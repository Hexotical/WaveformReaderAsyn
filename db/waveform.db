##Template file waveform

record(ao,      "$(P):SLOPE:0") {
    field(DESC, "Slope of channel in EGU/raw")
    field(DTYP, "asynInt32")
    field(PINI, "YES")
    field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))SLOPE0")
    field(SCAN, "Passive")
    field(PREC, "3")
    field(VAL,  "1")
    info(autosaveFields, "VAL")
}
record(ao,      "$(P):OFFSET:0") {
    field(DESC, "Offset of channel in EGU")
    field(DTYP, "asynInt32")
    field(PINI, "YES")
    field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))OFFSET0")
    field(SCAN, "Passive")
    field(PREC, "3")
    field(VAL,  "1")
    info(autosaveFields, "VAL")
}

record(waveform, "$(P):WAVEFORM:0")
{
    field(PINI, "1")
    field(DTYP, "asynInt16ArrayIn")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))WAVEFORM:0")
    field(FTVL, "SHORT")
    field(NELM, "$(WAVEFORM_SIZE)")
    #field(FLNK, "$(P):X_WAVEFORM:0 PP")
    field(FLNK, "$(P):SUBARRAY:0 PP")
    field(SCAN, "I/O Intr")
  }

record(subArray, "$(P):SUBARRAY:0")
{
  field(INP, "$(P):WAVEFORM:0.VAL")
  field(FTVL, "SHORT")
  field(MALM, "$(WAVEFORM_SIZE)")
  field(NELM, "25000")
  field(INDX, "0")
  field(SCAN, "Passive")
  }


record(longin, "$(P):BEGIN:ADDR:0")
{
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT), $(ADDR), $(TIMEOUT))BEGIN_ADDR0")
    field(SCAN, "I/O Intr")
  }


record(longin, "$(P):END:ADDR:0")
{
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT), $(ADDR), $(TIMEOUT))END_ADDR0")
    field(SCAN, "I/O Intr")
  }


record(ao, "$(P):WORD:COUNT:0")
{
    field(SCAN, "Passive")
    field(OUT, "$(P):INIT:SEQ:0  PP")
  }


record(seq, "$(P):INIT:SEQ:0")
{
    field(SCAN, "Passive")
    field(DOL1, "$(P):WORD:COUNT:0")
    field(LNK1, "$(P):FANOUT:BUFFER:0 PP")
    field(DO2, "1")
    field(LNK2, "$(P):WEB:INIT:0 PP")
  }


record(dfanout, "$(P):FANOUT:BUFFER:0")
{
    field(SCAN, "Passive")
    field(OUTA, "$(P):BUFFER:RBV:0 PP")
    field(OUTB, "$(P):TO:DIV:0.A PP")
    field(OUTC, "$(P):WEB:INIT:0.A PP")
  }


record(ai, "$(P):BUFFER:RBV:0")
{
    field(SCAN, "Passive")
  }


record(calcout, "$(P):TO:DIV:0")
{
    field(SCAN, "Passive")
    field(CALC, "A/2")
    field(OUT, "$(P):BUFFER:SIZE PP")
  }


# This represents the physical location of the maximum beam loss 
# computed by the maxBeamLoss function
# Assuming units of meters
record(ai, "$(P):BEAM:LOSS:LOC:0")
{
    field(DTYP, "asynFloat64")
    field(DESC, "Physical location of max beam loss")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))BEAM_LOSS_LOC0")
    field(PREC, "3")
    field(SCAN, "I/O Intr")
    field(EGU, "m")
}

# This represents the value of the maximum beam loss 
# computed by the maxBeamLoss function
record(ai, "$(P):BEAM:LOSS:VAL:0")
{
    field(DTYP, "asynInt32")
    field(DESC, "Physical location of max beam loss")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))BEAM_LOSS_VAL0")
    field(SCAN, "I/O Intr")
}

# This represents the threshold for finding the peak value of beam 
# loss; if the value is lower than this, then it should considered noise
record(ao, "$(P):THRESHOLD:0") 
{
  field(DTYP, "asynFloat64")
  field(PINI, "YES")
  field(SCAN, "Passive")
  field(DESC, "Threshold for beam loss")
  field(VAL, 0)
  field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))THRESHOLD:0")
}

# Length of the fiber
# Assuming units of meters 
record(ao,      "$(P):FIBER:LENGTH:0") {
    field(PINI, "YES")
    field(DESC, "Length in m")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))FIBER_LENGTH0")
    field(SCAN, "Passive")
    field(VAL,  "150")
    field(EGU, "m")
}

# Physical location of the start of the fiber
# Assuming units of meters
record(ao, "$(P):Z:OFFSET:START:0")
{
    field(DESC, "Location of the start of the fiber in m")
    field(PINI, "YES")
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))Z_OFFSET_START0")
    field(SCAN, "Passive")
    field(VAL,  "0")
    field(PREC, "3")
    field(EGU, "m")
}

# Physical location of the end of the fiber
# Assuming units of meters
record(ao,      "$(P):Z:OFFSET:END:0") {
    field(DESC, "Location of the end of the fiber in m")
    field(PINI, "YES")
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))Z_OFFSET_END0")
    field(SCAN, "Passive")
    field(VAL,  "100")
    field(PREC, "3")
    field(EGU, "m")
}

# Physical location of the start of the extraction range
# Assuming units of meters
record(ao,      "$(P):START:EXTRACTION:0") {
    field(PINI, "YES")
    field(DESC, "Start of extraction range in m")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))EXTRACTION_START0")
    field(SCAN, "Passive")
    field(VAL,  "20")
    field(PREC, "3")
    field(EGU, "m")
}

# Physical location of the end of the extraction range
# Assuming units of meters
record(ao,      "$(P):END:EXTRACTION:0") {
    field(PINI, "YES")
    field(DESC, "End of extraction range in m")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))EXTRACTION_END0")
    field(SCAN, "Passive")
    field(VAL,  "80")
    field(PREC, "3")
    field(EGU, "m")
}

# The number of samples in the extracted range of values
record(ai, "$(P):EXTRACTED:NO:OF:ELEMENTS:0")
{
    field(DTYP, "asynInt32")
    #field(PINI, "YES")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))EXTRACTED_NO_OF_ELEMENTS0")
    field(SCAN, "I/O Intr")
    #field(VAL, "100")
}

# The X-axis of the waveform before extraction, contains distance values in m
record(waveform, "$(P):COMPLETE:X:WF:0") 
{
  field(PINI, "1")
  field(DESC,    "X Subarray")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))COMPLETE_X_AXIS:0")
  field(DTYP, "asynFloat64ArrayIn")
  field(FTVL,    "DOUBLE")
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}

# Values of the waveform before extraction
record(waveform, "$(P):COMPLETE:WF:0") 
{
  field(PINI, "1")
  field(DESC,    "Subarray")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))COMPLETE_WAVEFORM:0")
  field(DTYP, "asynInt16ArrayIn")
  field(FTVL,    "SHORT")
  # NELM is the maximum number of values, NORD is the number of values actually read
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}

# The X-axis of the final extracted waveform, contains distance values in m
record(waveform, "$(P):EXTRACTED:X:WF:0") 
{
  field(PINI, "1")
  field(DESC,    "X Subarray")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))EXTRACTED_X_AXIS:0")
  field(DTYP, "asynFloat64ArrayIn")
  field(FTVL,    "DOUBLE")
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}

# Values of the extracted waveform
record(waveform, "$(P):EXTRACTED:WF:0") 
{
  field(PINI, "1")
  field(DESC,    "Extracted Subarray")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))EXTRACTED_WAVEFORM:0")
  field(DTYP, "asynInt16ArrayIn")
  field(FTVL,    "SHORT")
  # NELM is the maximum number of values, NORD is the number of values actually read
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}##Template file waveform

