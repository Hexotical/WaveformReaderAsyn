# PV to send data start and nelm to raw and wf PVs
record(seq, "$(USER):WF:SEQ:2") 
{
  field(DESC, "Update NELM and INDX value")
  field(DOL1, "$(USER):WF:START:2")
  field(LNK1, "$(USER):WF:RAW:2.INDX PP")

  field(DOL2, "$(USER):WF:NELM:2")
  field(LNK2, "$(USER):WF:RAW.NELM:2 PP")

  field(DOL3, "$(USER):WF:NELM:2")
  field(LNK3, "$(USER):WF.NELM:2 PP")

  field(DOL4, "$(USER):WF:START:2")
  field(LNK4, "$(USER):X:WF:2.INDX PP")

  field(DOL5, "$(USER):WF:NELM:2")
  field(LNK5, "$(USER):X:WF:2.NELM PP")

  field(ASG,  "Internal")
}


