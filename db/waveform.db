record(waveform, "$(USER):WAVEFORM:2")
{
    field(PINI, "1")
    field(DTYP, "asynInt16ArrayIn")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))WAVEFORM:2")
    field(FTVL, "SHORT")
    field(NELM, "$(WAVEFORM_SIZE)")
    field(FLNK, "$(USER):X_WAVEFORM:2 PP")
    field(SCAN, "I/O Intr")
  }

# Create a waveform with the sampling time. This will be the X axis of the
# waveform.
record (aSub, "$(USER):X_WAVEFORM:2") {
  field(SNAM, "calcTimeArray")
  field(FTA, "LONG")
  field(FTVA, "DOUBLE")
  field(NOVA, "$(WAVEFORM_SIZE)")
  field(INPA, "$(USER):CLK:FREQUENCY CP")
  field(OUTA, "$(USER):X_WF:2")
  field(FLNK, "$(USER):X_WF:2 PP")
}

# Interface PV, to display only the necessary data
# range from the data received in the buffer
record(subArray, "$(USER):X_WF:2") 
{
  field(DESC,    "X Subarray")
  field(INP,     "$(USER):X_WAVEFORM:2.VALA")
  field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))WAVEFORM_X_AXIS:2")
  field(FTVL,    "DOUBLE")
  field(MALM,    "$(WAVEFORM_SIZE)")
  field(NELM,    "1024")
  field(INDX,    "0")
  field(FLNK,    "$(USER):WAVEFORM:RAW:2 PP")
  field(EGU,     "ns")
}

# Interface PV, to display only the necessary data
# range from the data received in the buffer
record(subArray, "$(USER):WAVEFORM:RAW:2") 
{
  field(DESC,    "Raw Subarray")
  field(INP,     "$(USER):WAVEFORM:2")
  field(FTVL,    "SHORT")
  field(MALM,    "$(WAVEFORM_SIZE)")
  field(NELM,    "1024")
  field(INDX,    "0")
  #field(FLNK,   "$(USER):WAVEFORM:R2E:2 PP")
}

# PV to calculate the interface pv in user units
record (aSub, "$(USER):WAVEFORM:R2E:2") 
{
  field(DESC, "subarray raw to egu")
  field(SNAM, "calcWaveformInEGU")
  field(INPA, "$(USER):WF:RAW PP")
  field(NOA, "$(WAVEFORM_SIZE)")
  field(FTA, "SHORT")
  field(INPB, "$(USER):SLOPE:WF:2 PP")
  field(FTB, "DOUBLE")
  field(INPC, "$(USER):OFFSET:WF:2 PP")
  field(FTC, "SHORT")
  field(OUTA, "$(USER):WF:2")
  field(FLNK, "$(USER):WF:2")
  field(NOVA, "$(WAVEFORM_SIZE)")
  field(FTVA, "DOUBLE")
}

record(calcout, "$(USER):SLOPE:WF:CALC:2") 
{
  field(DESC,    "WF slope")
  field(PREC,    "3")
  field(FLNK,    "$(USER):SLOPE:WF:2")
  field(CALC,    "A*.5")
  field(INPA,    "$(USER):SLOPE:2 CPP")
}

# PV to hold the slope for the display array (raw to egu conversion)
record(ao, "$(USER):SLOPE:WF:2") 
{
  field(DESC,    "WF slope")
  field(PREC,    "3")
  field(PINI,    "YES")
  field(FLNK,    "$(USER):WAVEFORM:R2E:2")
  field(OMSL,    "closed_loop")
  field(DOL,     "$(USER):SLOPE:WF:CALC:2")
}

# PV to hold the offset for the display array (raw to egu conversion)
record(ao, "$(USER):OFFSET:WF:2") 
{
  field(DESC,    "WF offset in raw")
  field(PINI,    "YES")
  field(FLNK,    "$(USER):WAVEFORM:R2E:2")
  field(EGU,     "raw")
  field(OMSL,    "closed_loop")
  field(DOL,     "$(USER):OFFSET:CALC:2")
}

# Interface PV, to display only the necessary data
# range from the data received in the buffer in user units
record(subArray, "$(USER):WF:2") 
{
  field(DESC,    "Subarray")
