record(subArray, "$(P):SUBARRAY:1")
{
  field(INP, "$(P):WAVEFORM:1.VAL")
  field(FTVL, "SHORT")
  field(MALM, "$(WAVEFORM_SIZE)")
  field(NELM, "25000")
  field(INDX, "0")
  field(SCAN, "Passive")
  }


record(longin, "$(P):BEGIN:ADDR:1")
{
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT), $(ADDR), $(TIMEOUT))BEGIN_ADDR1")
    field(SCAN, "I/O Intr")
  }


record(longin, "$(P):END:ADDR:1")
{
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT), $(ADDR), $(TIMEOUT))END_ADDR1")
    field(SCAN, "I/O Intr")
  }


record(ao, "$(P):WORD:COUNT:1")
{
    field(SCAN, "Passive")
    field(OUT, "$(P):INIT:SEQ:1  PP")
  }


record(seq, "$(P):INIT:SEQ:1")
{
    field(SCAN, "Passive")
    field(DOL1, "$(P):WORD:COUNT:1")
    field(LNK1, "$(P):FANOUT:BUFFER:1 PP")
    field(DO2, "1")
    field(LNK2, "$(P):WEB:INIT:1 PP")
  }


record(dfanout, "$(P):FANOUT:BUFFER:1")
{
    field(SCAN, "Passive")
    field(OUTA, "$(P):BUFFER:RBV:1 PP")
    field(OUTB, "$(P):TO:DIV:1.A PP")
    field(OUTC, "$(P):WEB:INIT:1.A PP")
  }


record(ai, "$(P):BUFFER:RBV:1")
{
    field(SCAN, "Passive")
  }


record(calcout, "$(P):TO:DIV:1")
{
    field(SCAN, "Passive")
    field(CALC, "A/2")
    field(OUT, "$(P):BUFFER:SIZE PP")
  }


record(ao, "$(P):STARTING:LOC:1")
{
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))START_LOC1")
    field(SCAN, "Passive")
}


record(ao, "$(P):ENDING:LOC:1")
{
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))END_LOC1")
    field(SCAN, "Passive")
}


record(ai, "$(P):BEAM:LOSS:LOC:1")
{
    field(DTYP, "asynFloat64")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))BEAM_LOSS_LOC1")
    field(SCAN, "I/O Intr")
}

## This represents the threshold for finding the peak value of beam ##
## loss; if the value is lower than this, then it should considered noise ##
record(ao, "$(P):THRESHOLD:1") 
{
  field(DTYP, "asynInt32")
  field(SCAN, "Passive")
  field(DESC, "Threshold for beam loss")
  field(VAL, 0)
  field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))THRESHOLD:1")
}

# Length of the fiber
# Assuming units of meters 
record(ao,      "$(P):LENGTH:1") {
    field(DESC, "Length in m")
    field(PINI, "YES")
    field(SCAN, "Passive")
    field(PREC, "3")
    field(VAL,  "100")
    info(autosaveFields, "VAL")
}

