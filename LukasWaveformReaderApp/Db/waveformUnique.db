## Records common to all streams


record(bo, "$(P):WEB_INIT")
{
    field(DTYP, "asynUInt32Digital")
    field(SCAN, "Passive")
    field(OUT, "@asynMask($(PORT), $(ADDR), 1, $(TIMEOUT))INITIALIZE")
    field(ZNAM, "Why")
    field(ONAM, "INIT")
  }


# The DaqMuxV2/DataBufferSize is set to NO_OF_WORDS/2 (as this is expressed in 32-bit words)
record(longin, "$(P):BUFFER_SIZE")
{
    field(DTYP, "asynInt32")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn($(PORT), $(ADDR), $(TIMEOUT))BUFFER_SIZE")
  }


#Single register for all the things
record(bo, "$(P):RUN")
{
    field(SCAN, "Passive")
    field(DTYP, "asynUInt32Digital")
    field(OUT, "@asynMask($(PORT),$(ADDR), 1, $(TIMEOUT))RUN")
    #field(PINI, "1")
    field(ZNAM, "STOP")
    field(ONAM, "RUN")
  }


## This in the number of 16-bit words from the P (N) ##
record(ao, "$(P):NO_OF_WORDS") 
{
  field(DTYP, "asynInt32")
  field(SCAN, "Passive")
  field(DESC, "Buffer size (16-bit words)")
  field(EGU,  "words")
  field(PINI, "YES")
  field(VAL, "$(WAVEFORM_SIZE)")
  field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))NO_OF_WORDS")
  info(autosaveFields, "VAL")
}

# In Hz
record(longin, "$(P):CLK_FREQUENCY")
{
    field(DTYP, "asynInt32")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn($(PORT), $(ADDR), $(TIMEOUT))CLK_FREQUENCY")
}

# Represents the speed of light/beam loss particles in the beam
# Assuming units of m/ns
record(ao,      "$(P):FIBER_SPEED_OF_LIGHT") {
    field(PINI, "YES")
    field(DESC, "Speed of beam loss particles")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))FIBER_SPEED_OF_LIGHT")
    field(SCAN, "Passive")
    field(VAL,  "0.2")
}