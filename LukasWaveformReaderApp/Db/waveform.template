record(waveform, "$(P):WAVEFORM:${channel}")
{
    field(PINI, "1")
    field(DTYP, "asynInt16ArrayIn")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))WAVEFORM:$(channel)")
    field(FTVL, "SHORT")
    field(NELM, "$(WAVEFORM_SIZE)")
    #field(FLNK, "$(P):X_WAVEFORM:${channel} PP")
    field(FLNK, "$(P):SUBARRAY:${channel} PP")
    field(SCAN, "I/O Intr")
  }

