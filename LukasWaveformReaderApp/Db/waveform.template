##Template file waveform

record(ao,      "$(USER):SLOPE:${channel}") {
    field(DESC, "Slope of channel in EGU/raw")
    field(PINI, "YES")
    field(SCAN, "Passive")
    field(PREC, "3")
    field(VAL,  "1")
    info(autosaveFields, "VAL")
}
record(ao,      "$(USER):OFFSET:${channel}") {
    field(DESC, "Offset of channel in EGU")
    field(PINI, "YES")
    field(SCAN, "Passive")
    field(PREC, "3")
    field(VAL,  "1")
    info(autosaveFields, "VAL")
}

