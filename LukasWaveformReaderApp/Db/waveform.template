##Template file waveform

record(ao,      "$(P):SLOPE_${channel}") {
    field(DESC, "Slope of channel in EGU/raw")
    field(DTYP, "asynInt32")
    field(PINI, "YES")
    field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))SLOPE${channel}")
    field(SCAN, "Passive")
    field(PREC, "3")
    field(VAL,  "1")
    info(autosaveFields, "VAL")
}
record(ao,      "$(P):OFFSET_${channel}") {
    field(DESC, "Offset of channel in EGU")
    field(DTYP, "asynInt32")
    field(PINI, "YES")
    field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))OFFSET${channel}")
    field(SCAN, "Passive")
    field(PREC, "3")
    field(VAL,  "1")
    info(autosaveFields, "VAL")
}

record(waveform, "$(P):WAVEFORM_${channel}")
{
    field(PINI, "1")
    field(DESC, "Raw input buffer data")
    field(DTYP, "asynInt16ArrayIn")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))WAVEFORM_$(channel)")
    field(FTVL, "SHORT")
    field(NELM, "$(WAVEFORM_SIZE)")
    field(FLNK, "$(P):SUBARRAY_${channel} PP")
    field(SCAN, "I/O Intr")
  }

record(subArray, "$(P):SUBARRAY_${channel}")
{
  field(INP, "$(P):WAVEFORM_${channel}.VAL")
  field(FTVL, "SHORT")
  field(MALM, "$(WAVEFORM_SIZE)")
  field(NELM, "25000")
  field(INDX, "0")
  field(SCAN, "Passive")
  }


record(longin, "$(P):BEGIN_ADDR_${channel}")
{
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT), $(ADDR), $(TIMEOUT))BEGIN_ADDR${channel}")
    field(SCAN, "I/O Intr")
  }


record(longin, "$(P):END_ADDR_${channel}")
{
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT), $(ADDR), $(TIMEOUT))END_ADDR${channel}")
    field(SCAN, "I/O Intr")
  }


record(ao, "$(P):WORD_COUNT_${channel}")
{
    field(SCAN, "Passive")
    field(OUT, "$(P):INIT_SEQ_${channel}  PP")
  }


record(seq, "$(P):INIT_SEQ_${channel}")
{
    field(SCAN, "Passive")
    field(DOL1, "$(P):WORD_COUNT_${channel}")
    field(LNK1, "$(P):FANOUT_BUFFER_${channel} PP")
    field(DO2, "1")
    field(LNK2, "$(P):WEB_INIT_${channel} PP")
  }


record(dfanout, "$(P):FANOUT_BUFFER_${channel}")
{
    field(SCAN, "Passive")
    field(OUTA, "$(P):BUFFER_RBV_${channel} PP")
    field(OUTB, "$(P):TO_DIV_${channel}.A PP")
    field(OUTC, "$(P):WEB_INIT_${channel}.A PP")
  }


record(ai, "$(P):BUFFER_RBV_${channel}")
{
    field(SCAN, "Passive")
  }


record(calcout, "$(P):TO_DIV_${channel}")
{
    field(SCAN, "Passive")
    field(CALC, "A/2")
    field(OUT, "$(P):BUFFER_SIZE PP")
  }


# This represents the physical location of the maximum beam loss 
# computed by the maxBeamLoss function
# Assuming units of meters
record(ai, "$(P):BEAM_LOSS_Z_${channel}")
{
    field(DTYP, "asynFloat64")
    field(DESC, "Z-value of max beam loss")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))BEAM_LOSS_Z${channel}")
    field(PREC, "3")
    field(SCAN, "I/O Intr")
    field(EGU, "m")
}

# This represents the value of the maximum beam loss 
# computed by the maxBeamLoss function
record(ai, "$(P):BEAM_LOSS_${channel}")
{
    field(DTYP, "asynInt32")
    field(DESC, "Maximum beam loss value")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))BEAM_LOSS${channel}")
    field(SCAN, "I/O Intr")
}

# This represents the threshold for finding the peak value of beam 
# loss; if the value is lower than this, then it should considered noise
record(ao, "$(P):THRESHOLD_${channel}") 
{
  field(DTYP, "asynFloat64")
  field(PINI, "YES")
  field(SCAN, "Passive")
  field(DESC, "Threshold for max beam loss")
  field(VAL, 0)
  field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))THRESHOLD${channel}")
}

# Length of the optical fiber
# Assuming units of meters 
record(ao,      "$(P):FIBER_LENGTH_${channel}") {
    field(PINI, "YES")
    field(DESC, "Length in m")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))FIBER_LENGTH${channel}")
    field(SCAN, "Passive")
    field(VAL,  "150")
    field(EGU, "m")
}

# Physical location of the start of the fiber
# Assuming units of meters
record(ao, "$(P):Z_OFFSET_START_${channel}")
{
    field(DESC, "Start of the fiber in m")
    field(PINI, "YES")
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))Z_OFFSET_START${channel}")
    field(SCAN, "Passive")
    field(VAL,  "0")
    field(PREC, "3")
    field(EGU, "m")
}

# Physical location of the end of the fiber
# Assuming units of meters
record(ao,      "$(P):Z_OFFSET_END_${channel}") {
    field(DESC, "End of the fiber in m")
    field(PINI, "YES")
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn($(PORT),$(ADDR),$(TIMEOUT))Z_OFFSET_END${channel}")
    field(SCAN, "Passive")
    field(VAL,  "100")
    field(PREC, "3")
    field(EGU, "m")
}

# Physical location of the start of the region of interest
# Assuming units of meters
record(ao,      "$(P):ROI_START_${channel}") {
    field(PINI, "YES")
    field(DESC, "Start of ROI in m")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))ROI_START${channel}")
    field(SCAN, "Passive")
    field(VAL,  "20")
    field(PREC, "3")
    field(EGU, "m")
}

# Physical location of the end of the region of interest
# Assuming units of meters
record(ao,      "$(P):ROI_END_${channel}") {
    field(PINI, "YES")
    field(DESC, "End of ROI in m")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT), $(ADDR), $(TIMEOUT))ROI_END${channel}")
    field(SCAN, "Passive")
    field(VAL,  "80")
    field(PREC, "3")
    field(EGU, "m")
}

# The number of samples in the region of interest
record(ai, "$(P):ROI_NELM_${channel}")
{
    field(DTYP, "asynInt32")
    field(DESC, "NELM in ROI")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))ROI_NELM${channel}")
    field(SCAN, "I/O Intr")
}

# The Z-axis of the complete waveform, before extracting region of interest, 
# contains distance values in m
record(waveform, "$(P):COMPLETE_Z_${channel}") 
{
  field(PINI, "1")
  field(DESC,    "Z values of complete waveform")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))COMPLETE_Z_$(channel)")
  field(DTYP, "asynFloat64ArrayIn")
  field(FTVL,    "DOUBLE")
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}

# Beam loss values, before extracting region of interest
record(waveform, "$(P):COMPLETE_BEAM_LOSS_${channel}") 
{
  field(PINI, "1")
  field(DESC,    "Beam loss values")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))COMPLETE_BEAM_LOSS_$(channel)")
  field(DTYP, "asynInt16ArrayIn")
  field(FTVL,    "SHORT")
  # NELM is the maximum number of values, NORD is the number of values actually read
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}

# The Z-axis of the region of interest, contains distance values in m
record(waveform, "$(P):ROI_Z_${channel}") 
{
  field(PINI, "1")
  field(DESC,    "Z values of ROI")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))ROI_Z_$(channel)")
  field(DTYP, "asynFloat64ArrayIn")
  field(FTVL,    "DOUBLE")
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}

# Beam loss values in ROI
record(waveform, "$(P):ROI_BEAM_LOSS_${channel}") 
{
  field(PINI, "1")
  field(DESC,    "Beam loss values in ROI")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))ROI_BEAM_LOSS_$(channel)")
  field(DTYP, "asynInt16ArrayIn")
  field(FTVL,    "SHORT")
  # NELM is the maximum number of values, NORD is the number of values actually read
  field(NELM,    "$(WAVEFORM_SIZE)")
  field(SCAN, "I/O Intr")
}

# Store the time passed between the current and previous 
# retrieval of data from a stream
record(ai, "$(P):INTERVAL_${channel}")
{
    field(DTYP, "asynInt32")
    #field(PINI, "YES")
    field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))INTERVAL${channel}")
    field(SCAN, "I/O Intr")
    #field(VAL, "100")
}

# Set to TRUE if the waveform should be extracted, FALSE if not
# determined by whether the max value of the waveform data is
# above the threshold or not
record(bi, "$(P):EXTRACT_RBV_${channel}")
{
    field(SCAN, "I/O Intr")
    field(DESC, "Whether to extract waveform")
    field(DTYP, "asynUInt32Digital")
    field(INP, "@asynMask($(PORT),$(ADDR), 1, $(TIMEOUT))EXTRACT${channel}")
    field(ZNAM, "FALSE")
    field(ONAM, "TRUE")
  }

# Used to reset the value of "$(P):EXTRACT_${channel}" from the IOC
record(bo, "$(P):EXTRACT_${channel}")
{
    field(SCAN, "Passive")
    field(DTYP, "asynUInt32Digital")
    field(OUT, "@asynMask($(PORT),$(ADDR), 1, $(TIMEOUT))EXTRACT${channel}")
    field(ZNAM, "FALSE")
    field(ONAM, "TRUE")
    field(FLNK, "$(P):EXTRACT_${channel}")
  }